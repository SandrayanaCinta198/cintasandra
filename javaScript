}


function buatDataPenjualan() {

  const spreadsheet =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    spreadsheet.getActiveSheet();

  // Bersihkan sheet
  sheet.clear();

  // Header
  sheet.getRange("A1:E1").setValues([
    [
      "No",
      "Produk",
      "Jumlah",
      "Harga Satuan",
      "Total"
    ]
  ]);

  // Data contoh
  const data = [
    [1, "Laptop", 3, 8000000],
    [2, "Mouse", 10, 150000],
    [3, "Keyboard", 5, 350000],
    [4, "Monitor", 2, 2000000],
    [5, "Printer", 1, 1500000]
  ];

  sheet.getRange("A2:D6").setValues(data);

  // Rumus total
  sheet.getRange("E2").setFormula("=C2*D2");

  sheet.getRange("E2:E6").fillDown();

  // Total keseluruhan
  sheet.getRange("D8").setValue("TOTAL PENJUALAN");

  sheet.getRange("E8")
    .setFormula("=SUM(E2:E6)");

  // Format header
  sheet.getRange("A1:E1")
    .setFontWeight("bold")
    .setBackground("#d9ead3");

  // Format Rupiah
  sheet.getRange("D2:E8")
    .setNumberFormat('"Rp" #,##0');

  // Sesuaikan lebar kolom
  sheet.autoResizeColumns(1, 5);

  return "Data penjualan berhasil dibuat!";
}
